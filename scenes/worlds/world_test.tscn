[sub_resource type="GDScript" id="GDScript_c5aoa"]
script/source = "extends WorldTemplate

@onready var light: DirectionalLight2D = $Lights/DirectionalLight2D

func _on_zoom_camera_lock_body_entered(body: Node2D) -> void:
	var tween = create_tween()
	tween.tween_property(light, \"energy\", 3.0, 2.0)
	AuCameraDirector.shake_heavy()

func _on_zoom_camera_lock_body_exited(body: Node2D) -> void:
	var tween = create_tween()
	tween.tween_property(light, \"energy\", 1.5, 2.0)
"

