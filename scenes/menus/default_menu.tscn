[gd_scene format=3]

[ext_resource type="PackedScene" path="res://scenes/menus/components/buttons/focus_button.tscn" id="1_qnqyb"]
[ext_resource type="Theme" path="res://assets/ui/misted_theme.tres" id="2_theme"]

[sub_resource type="GDScript" id="GDScript_dv1nh"]
script/source = "# 场景专属薄逻辑：处理主菜单按钮导航，无复用需求，保持内联。
# 按钮统一接 pressed：确认音由 autoload 上的 UiAudio 播放，切场景不会把它掐断，
# 因此按下即可跳转，不需要等音效放完。

extends Control

func _ready() -> void:
	Tr.apply(self)

func _on_start_pressed() -> void:
	Globals.go_to_game()

func _on_system_button_pressed() -> void:
	Globals.go_to_system_settings()

func _on_quit_button_pressed() -> void:
	Globals.quit_game()
"

[node name="DefaultMenu" type="Control" unique_id=813206640]
layout_mode = 3
