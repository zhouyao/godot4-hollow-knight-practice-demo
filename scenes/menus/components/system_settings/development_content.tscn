[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/menus/components/system_settings/development_content.gd" id="1_dvc"]

[node name="DevelopmentContent" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 36
script = ExtResource("1_dvc")

[node name="DevelopmentTitle" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "开发设置"

[node name="DebugModeRow" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 24

[node name="NameLabel" type="Label" parent="DebugModeRow"]
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
text = "是否开启调试模式"
horizontal_alignment = 2

[node name="DebugModeOption" type="OptionButton" parent="DebugModeRow"]
custom_minimum_size = Vector2(320, 52)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"RowButton"
alignment = 1

[connection signal="item_selected" from="DebugModeRow/DebugModeOption" to="." method="_on_debug_mode_option_item_selected"]
