[sub_resource type="GDScript" id="GDScript_acfms"]
script/source = "# 场景专属薄逻辑：左侧 tab 切换右侧内容 + 音量预览音 + 语言切换后重刷文案，无复用需求，保持内联。

extends Control

const PREVIEW_STREAM := preload(\"res://assets/sounds/menus/confirm.wav\")

@onready var tab_operations: FocusButton = $Margin/Columns/TabList/TabOperations
@onready var tab_audio: FocusButton = $Margin/Columns/TabList/TabAudio
@onready var tab_language: FocusButton = $Margin/Columns/TabList/TabLanguage

@onready var operations_content: Control = $Margin/Columns/ContentPanel/OperationsContent
@onready var audio_content: Control = $Margin/Columns/ContentPanel/AudioContent
@onready var language_content: Control = $Margin/Columns/ContentPanel/LanguageContent
@onready var language_name_label: Label = $Margin/Columns/ContentPanel/LanguageContent/OptionRow/NameLabel
@onready var language_option: OptionButton = $Margin/Columns/ContentPanel/LanguageContent/OptionRow/LanguageOption
@onready var bind_header: Control = $Margin/Columns/ContentPanel/OperationsContent/BindHeader

@onready var preview_player: AudioStreamPlayer = $PreviewPlayer

func _ready() -> void:
	tab_operations.pressed.connect(_on_tab_pressed.bind(\"operations\"))
	tab_audio.pressed.connect(_on_tab_pressed.bind(\"audio\"))
	tab_language.pressed.connect(_on_tab_pressed.bind(\"language\"))

	Settings.volume_committed.connect(_on_volume_preview)
	Settings.locale_changed.connect(_on_locale_changed)

	_apply_header_widths()
	language_name_label.custom_minimum_size.x = MenuRow.NAME_MIN_WIDTH
	_build_language_option()
	language_option.item_selected.connect(_on_language_selected)
	_select_tab(\"operations\")
	Tr.apply(self)
	tab_operations.quiet_focus()

func _exit_tree() -> void:
	if Settings.volume_committed.is_connected(_on_volume_preview):
		Settings.volume_committed.disconnect(_on_volume_preview)
	if Settings.locale_changed.is_connected(_on_locale_changed):
		Settings.locale_changed.disconnect(_on_locale_changed)

# Esc / 手柄取消：正在监听按键时先退出监听，否则返回主菜单
func _unhandled_input(event: InputEvent) -> void:
	if !event.is_action_pressed(&\"ui_cancel\"):
		return
	get_viewport().set_input_as_handled()
	if get_tree().get_nodes_in_group(KeyBindingRow.LISTENING_GROUP).is_empty():
		Globals.go_to_main_menu()
		return
	KeyBindingRow.stop_all_listening(get_tree())

func _on_tab_pressed(tab: String) -> void:
	KeyBindingRow.stop_all_listening(get_tree())
	_select_tab(tab)

func _select_tab(tab: String) -> void:
	operations_content.visible = tab == \"operations\"
	audio_content.visible = tab == \"audio\"
	language_content.visible = tab == \"language\"

# 下拉框选项由 Settings.LOCALE_OPTIONS 生成，加一门语言只改那一处。
# 选项文字用语言自己的写法，不参与当前语言的翻译
func _build_language_option() -> void:
	for locale in Settings.LOCALE_OPTIONS:
		language_option.add_item(Settings.locale_display_name(locale))
	_sync_language_option()

func _on_language_selected(index: int) -> void:
	Settings.set_locale(Settings.LOCALE_OPTIONS[index])

# 切语言后不重载场景：菜单是短命的，把新语言重新套一遍即可
func _on_locale_changed(_locale: String) -> void:
	Tr.apply(self)
	_sync_language_option()

# 选中项已经是当前语言时就不再回写，避免下拉框与 set_locale 互相触发
func _sync_language_option() -> void:
	var index := Settings.LOCALE_OPTIONS.find(Settings.get_locale())
	if language_option.selected != index:
		language_option.selected = index

# 表头与行共用同一组宽度常量，改一次就能整体对齐
func _apply_header_widths() -> void:
	_set_header_width(\"NameLabel\", MenuRow.NAME_MIN_WIDTH)
	_set_header_width(\"KeyboardLabel\", KeyBindingRow.SLOT_MIN_WIDTH)
	_set_header_width(\"KeyboardSpacer\", KeyBindingRow.RESET_MIN_WIDTH)
	_set_header_width(\"GamepadLabel\", KeyBindingRow.SLOT_MIN_WIDTH)
	_set_header_width(\"GamepadSpacer\", KeyBindingRow.RESET_MIN_WIDTH)

func _set_header_width(child_name: String, width: float) -> void:
	var child: Control = bind_header.get_node_or_null(child_name) as Control
	if child != null:
		child.custom_minimum_size.x = width

# 只在一次调节结束（滑条松手 / 重置）时播放，避免拖动过程中重复触发
func _on_volume_preview(bus_name: String) -> void:
	preview_player.bus = bus_name
	preview_player.stream = PREVIEW_STREAM
	preview_player.play()

func _on_back_button_pressed() -> void:
	Globals.go_to_main_menu()
"

