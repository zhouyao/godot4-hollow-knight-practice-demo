; 键盘 / 手柄各包一层 HBox：重置按钮紧跟在本列按键后面（间距 8），
; 列与列之间才是 28，这样那个小图标不会漂在两列正中间、看不出属于谁。
; 两列都带 expand：整行铺满内容区宽度，按键下划线随窗口变宽，不再挤成中间一条窄表。
; 行末 HintLabel 只占固定宽度（文字本身会溢出绘制），把余量全留给两列。
[node name="KeyBindingRow" type="HBoxContainer"]
size_flags_vertical = 4
theme_override_constants/separation = 28
script = ExtResource("1_kbr")
display_name = "动作"

[node name="NameLabel" type="Label" parent="." unique_id=412185056]
