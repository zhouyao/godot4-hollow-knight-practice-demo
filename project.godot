; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Misted"
run/main_scene="uid://dnhvawra6o88v"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

audio/buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

Globals="*uid://ueysvl4eaalp"
Inventory="*res://globals/autoload/Inventory.gd"
DropSpawner="*res://globals/autoload/DropSpawner.gd"
Settings="*uid://byknb1nladkm7"
UiAudio="*uid://b0xaosluegwol"
TransitionLayer="*uid://b7cjeemjxyyyp"
AuCameraDirector="*uid://dwvbfunxlwt7s"
AuZoneDirector="*res://addons/zone_director/AuZoneDirector.gd"
Skills="*res://resources/skills/skills_autoload.gd"
PlayerCombat="*res://globals/autoload/PlayerCombat.gd"
SaveManager="*res://globals/autoload/SaveManager.gd"
GameSession="*res://globals/autoload/GameSession.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="res://assets/sprites/cursor/cursor.png"

[editor_plugins]

enabled=PackedStringArray("res://addons/camera_director/plugin.cfg", "res://addons/environment_fx/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/sprite_frames_to_animation_player/plugin.cfg", "res://addons/zone_director/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://resources/": "blue",
"res://scenes/characters/": "pink",
"res://scenes/characters/enemies/": "red",
"res://scenes/characters/enemies/_base/": "gray",
"res://scenes/characters/npcs/": "orange",
"res://scenes/characters/players/": "purple",
"res://scenes/debug/": "gray",
"res://scenes/drops/": "yellow",
"res://scenes/menus/": "orange",
"res://scenes/menus/common/": "gray",
"res://scenes/projectiles/": "yellow",
"res://scenes/props/": "teal",
"res://scenes/ui/": "orange",
"res://scenes/worlds/": "green"
}

[global_group]

player=""
enemy=""

[gui]

theme/theme="res://assets/themes/misted_theme.tres"

