[internationalization]

locale/translations=PackedStringArray("res://localization/translations.en.translation", "res://localization/translations.zh_CN.translation", "res://localization/translations.zh_TW.translation")

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Enemies"
2d_physics/layer_3="Objects"
2d_physics/layer_4="Projectiles"
2d_physics/layer_5="Areas and Zones"
2d_physics/layer_6="Player Enemy Detection"
2d_physics/layer_7="No Player Collision"
2d_physics/layer_8="Drops"
2d_physics/layer_9="Background Destroy"

[physics]

common/physics_jitter_fix=0.0
common/physics_interpolation=true

[rendering]

renderer/rendering_method="gl_compatibility"
